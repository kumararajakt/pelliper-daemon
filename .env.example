# Pelliper OAuth2 credentials
# Copy this file to ~/.local/share/pelliper/.env or ./.env
# and fill in your values.

# Google / Gmail
PELLIPER_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
PELLIPER_GOOGLE_CLIENT_SECRET=

# Microsoft / Outlook
PELLIPER_MICROSOFT_CLIENT_ID=
PELLIPER_MICROSOFT_CLIENT_SECRET=
